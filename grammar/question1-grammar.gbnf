root ::= "```" singleLineComment+ importstmt+ statement+ endmarker "```"
importstmt ::= (importname | importfrom) newline
importname ::= "import " dottedasnames

# note below: the ('.' | '...') is necessary because '...' is tokenized as ELLIPSIS
importfrom ::= ( "from " ( ("." | "...")* dottedname | ("." | "...")+ ) " import " ( "*" | "(" importasnames ")" | importasnames ) )
importasname ::= name (" as " name)?
dottedasname ::= dottedname (" as " name)?
importasnames ::= importasname (", " importasname)* (", ")?
dottedasnames ::= dottedasname (", " dottedasname)*
dottedname ::= name ("." name)*

statement ::=
    ( singleLineComment* name space "=" space expression singleLineComment+ newline) |
    ( singleLineComment* name "(" arglist? ")" singleLineComment+ newline)

expression ::= term ( ( "+" | "-" ) term)*
term ::= factor ( ( "*" | "@" | "/" | "%" | "//" ) factor)*
factor ::= ( "+" | "-" | "~" ) factor | power
power ::= atomexpr ("**" factor)?
atomexpr ::= atom (trailer)*
atom ::=
    ( "(" space (testlistcomp)? space ")" ) |
    ( "[" space (testlistcomp)? space "]" ) |
    ( "{" space (dictorsetmaker)? space  "}" ) |
    value |
    name

testlistcomp ::= namedexprtest "," (namedexprtest)* (",")?
# Change name to lib to indicate library logic if matched
trailer ::= "." lib | "(" (arglist)? ")" | "[" subscriptlist "]"
subscriptlist ::= subscript ("," subscript)* (",")?
subscript ::= test | (test)? ":" (test)? (sliceop)?
sliceop ::= ":" (test)?
dictorsetmaker ::= 
       ( ((test ":" test | "**" expression) ("," (test ":" test | "**" expression))* (",")?) |
       ( test "," (test)* (",")?) )

namedexprtest ::= test (":= " test)?
test ::= expression (compop expression)*
compop ::= ( "<" | ">" | "==" | ">=" | "<=" | "<>" | "!=" | " in " | " not in " | " is " | " is not " )

classdef ::= "class " name ("(" space? (arglist)? space? ")")? ":" suite

suite ::= newline indent statement

arglist ::= argument ("," argument)*  (",")?
argument ::= atomexpr | atomexpr "=" atomexpr

# Adds library logic
lib ::= libmethods

endmarker ::= ""
indent ::= "\t"
newline ::= "\n"
name ::= [a-zA-Z_] [a-zA-Z_0-9]*
ws ::= ([ \t\n]+)
singleLineComment ::= "#" [^\n]* "\n"?
unknown ::= value
kwargs ::= testlistcomp
DataFrame ::= "DataFrame" "("  (DataFrame-data-kv DataFrame-data-rest | DataFrame-index-kv DataFrame-index-rest | DataFrame-columns-kv DataFrame-columns-rest | DataFrame-dtype-kv DataFrame-dtype-rest | DataFrame-copy-kv )? ")" ( "." ( DataFrame-boxplot | DataFrame-add-prefix | DataFrame-attrs ) )?
DataFrame-add-prefix ::= add-prefix
DataFrame-attrs ::= "data" | "index" | "columns" | "dtype" | "copy"
DataFrame-boxplot ::= boxplot
DataFrame-columns ::= value
DataFrame-columns-kv ::= ("columns" space "=" space)? (DataFrame-columns | atomexpr)
DataFrame-columns-rest ::= ( "," space DataFrame-dtype-kv )? DataFrame-dtype-rest
DataFrame-copy ::= value
DataFrame-copy-kv ::= ("copy" space "=" space)? (DataFrame-copy | atomexpr)
DataFrame-data ::= value
DataFrame-data-kv ::= ("data" space "=" space)? (DataFrame-data | atomexpr)
DataFrame-data-rest ::= ( "," space DataFrame-index-kv )? DataFrame-index-rest
DataFrame-dtype ::= bool
DataFrame-dtype-kv ::= ("dtype" space "=" space)? (DataFrame-dtype | atomexpr)
DataFrame-dtype-rest ::= ( "," space DataFrame-copy-kv )?
DataFrame-index ::= value
DataFrame-index-kv ::= ("index" space "=" space)? (DataFrame-index | atomexpr)
DataFrame-index-rest ::= ( "," space DataFrame-columns-kv )? DataFrame-columns-rest
add-prefix ::= "add_prefix" "(" add-prefix-prefix-kv ( "," space ( add-prefix-axis-kv ) )? ")"
add-prefix-attrs ::= "prefix" | "axis"
add-prefix-axis ::= "\"0\"" | "\"'index'\"" | "\"1\"" | "\"'columns'\"" | "\"None\""
add-prefix-axis-kv ::= ("axis" space "=" space)? (add-prefix-axis | atomexpr)
add-prefix-prefix ::= string
add-prefix-prefix-kv ::= ("prefix" space "=" space)? (add-prefix-prefix | atomexpr)
array ::= "[" space ( value ("," space value)* )? "]" space
bool ::= ("True" | "False") space
boxplot ::= "boxplot" "(" boxplot-fontsize-kv "," space boxplot-figsize-kv ( "," space ( boxplot-column-kv boxplot-column-rest | boxplot-by-kv boxplot-by-rest | boxplot-ax-kv boxplot-ax-rest | boxplot-rot-kv boxplot-rot-rest | boxplot-grid-kv boxplot-grid-rest | boxplot-layout-kv boxplot-layout-rest | boxplot-return-type-kv boxplot-return-type-rest | boxplot-backend-kv boxplot-backend-rest | boxplot-kwargs-kv ) )? ")"
boxplot-attrs ::= "fontsize" | "figsize" | "column" | "by" | "ax" | "rot" | "grid" | "layout" | "return_type" | "backend" | "kwargs"
boxplot-ax ::= value
boxplot-ax-kv ::= ("ax" space "=" space)? (boxplot-ax | atomexpr)
boxplot-ax-rest ::= ( "," space boxplot-rot-kv )? boxplot-rot-rest
boxplot-backend ::= string
boxplot-backend-kv ::= ("backend" space "=" space)? (boxplot-backend | atomexpr)
boxplot-backend-rest ::= ( "," space boxplot-kwargs-kv )?
boxplot-by ::= value
boxplot-by-kv ::= ("by" space "=" space)? (boxplot-by | atomexpr)
boxplot-by-rest ::= ( "," space boxplot-ax-kv )? boxplot-ax-rest
boxplot-column ::= string | array
boxplot-column-kv ::= ("column" space "=" space)? (boxplot-column | atomexpr)
boxplot-column-rest ::= ( "," space boxplot-by-kv )? boxplot-by-rest
boxplot-figsize ::= value
boxplot-figsize-kv ::= ("figsize" space "=" space)? (boxplot-figsize | atomexpr)
boxplot-fontsize ::= number | string
boxplot-fontsize-kv ::= ("fontsize" space "=" space)? (boxplot-fontsize | atomexpr)
boxplot-grid ::= bool
boxplot-grid-kv ::= ("grid" space "=" space)? (boxplot-grid | atomexpr)
boxplot-grid-rest ::= ( "," space boxplot-layout-kv )? boxplot-layout-rest
boxplot-kwargs ::= kwargs
boxplot-kwargs-kv ::= ("kwargs" space "=" space)? (boxplot-kwargs | atomexpr)
boxplot-layout ::= value
boxplot-layout-kv ::= ("layout" space "=" space)? (boxplot-layout | atomexpr)
boxplot-layout-rest ::= ( "," space boxplot-return-type-kv )? boxplot-return-type-rest
boxplot-return-type ::= "\"'axes'\"" | "\"'dict'\"" | "\"'both'\""
boxplot-return-type-kv ::= ("return_type" space "=" space)? (boxplot-return-type | atomexpr)
boxplot-return-type-rest ::= ( "," space boxplot-backend-kv )? boxplot-backend-rest
boxplot-rot ::= number
boxplot-rot-kv ::= ("rot" space "=" space)? (boxplot-rot | atomexpr)
boxplot-rot-rest ::= ( "," space boxplot-grid-kv )? boxplot-grid-rest
char ::= [^"\\] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F])
decimal-part ::= [0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9])?)?)?)?)?)?)?)?)?)?)?)?)?)?)?
integral-part ::= [0-9] | [1-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9])?)?)?)?)?)?)?)?)?)?)?)?)?)?)?
kwargs ::= ""
libmethods ::= "pd." pdlibmethods
pdlibmethods ::= boxplot | add-prefix | DataFrame
none ::= "None" space
null ::= "null" space
number ::= ("-"? integral-part) ("." decimal-part)? ([eE] [-+]? integral-part)? space
object ::= "{" space ( string ":" space value ("," space string ":" space value)* )? "}" space
space ::= " "?
string ::= "\"" char* "\"" space
value ::=  bool  |  null  |  number  | object  |  none |  array  |  string 