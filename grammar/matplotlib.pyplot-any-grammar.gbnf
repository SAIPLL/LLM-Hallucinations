root ::= (except-lib* mandatory-space library mandatory-space except-lib*)*

expression ::= term ( ( "+" | "-" ) term)*
term ::= factor ( ( "*" | "@" | "/" | "%" | "//" ) factor)*
factor ::= ( "+" | "-" | "~" ) factor | power
power ::= atomexpr ("**" factor)?
atomexpr ::= atom (trailer)*
atom ::=
    ( "(" space (testlistcomp)? space ")" ) |
    ( "[" space (testlistcomp)? space "]" ) |
    ( "{" space (dictorsetmaker)? space  "}" ) |
    value

testlistcomp ::= namedexprtest "," (namedexprtest)* (",")?
# Change name to lib to indicate library logic if matched
trailer ::= library | "." methods | "(" (arglist)? ")" | "[" subscriptlist "]"
subscriptlist ::= subscript ("," subscript)* (",")?
subscript ::= test | (test)? ":" (test)? (sliceop)?
sliceop ::= ":" (test)?
dictorsetmaker ::= 
       ( ((test ":" test | "**" expression) ("," (test ":" test | "**" expression))* (",")?) |
       ( test "," (test)* (",")?) )

namedexprtest ::= test (":= " test)?
test ::= expression (compop expression)*
compop ::= ( "<" | ">" | "==" | ">=" | "<=" | "<>" | "!=" | " in " | " not in " | " is " | " is not " )

arglist ::= argument ("," argument)*  (",")?
argument ::= atomexpr | atomexpr "=" atomexpr

endmarker ::= ""
indent ::= "\t"
newline ::= "\n"
name ::= [a-zA-Z_] [a-zA-Z_0-9]*
ws ::= ([ \t\n]+)
singleLineComment ::= "#" [^\n]* "\n"
unknown ::= value
kwargs ::= testlistcomp
array ::= "[" space ( value ("," space value)* )? "]" space
bool ::= ("True" | "False") space
char ::= [^"\\] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F])
decimal-part ::= [0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9])?)?)?)?)?)?)?)?)?)?)?)?)?)?)?
integral-part ::= [0-9] | [1-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9])?)?)?)?)?)?)?)?)?)?)?)?)?)?)?
integer ::= ("-"? integral-part) space
null ::= "null" space
none ::= "None" space
number ::= ("-"? integral-part) ("." decimal-part)? ([eE] [-+]? integral-part)? space
object ::= "{" space ( string ":" space value ("," space string ":" space value)* )? "}" space
space ::= " "?
mandatory-space ::= " "
string ::= "\"" char* "\"" space
value ::= object | array | string | number | bool | null | none

# Adds library logic
methods ::= name | plt-lib-methods
plt-annotation ::= "Annotation" "(" plt-annotation-text-kv "," space plt-annotation-xy-kv "," space plt-annotation-xytext-kv "," space plt-annotation-xycoords-kv "," space plt-annotation-textcoords-kv "," space plt-annotation-annotation-clip-kv ( "," space ( plt-annotation-arrowprops-kv ) )? ")" ( "." ( plt-annotation-add-callback | plt-annotation-contains | plt-annotation-convert-xunits | plt-annotation-convert-yunits | plt-annotation-draggable | plt-annotation-draw | plt-annotation-findobj | plt-annotation-format-cursor-data | plt-annotation-get-agg-filter | plt-annotation-get-alpha | plt-annotation-get-animated | plt-annotation-get-anncoords | plt-annotation-get-annotation-clip | plt-annotation-get-antialiased | plt-annotation-get-bbox-patch | plt-annotation-get-c | plt-annotation-get-children | plt-annotation-get-clip-box | plt-annotation-get-clip-on | plt-annotation-get-clip-path | plt-annotation-get-color | plt-annotation-get-cursor-data | plt-annotation-get-family | plt-annotation-get-figure | plt-annotation-get-font | plt-annotation-get-font-properties | plt-annotation-get-fontfamily | plt-annotation-get-fontname | plt-annotation-get-fontproperties | plt-annotation-get-fontsize | plt-annotation-get-fontstyle | plt-annotation-get-fontvariant | plt-annotation-get-fontweight | plt-annotation-get-gid | plt-annotation-get-ha | plt-annotation-get-horizontalalignment | plt-annotation-get-in-layout | plt-annotation-get-label | plt-annotation-get-math-fontfamily | plt-annotation-get-mouseover | plt-annotation-get-name | plt-annotation-get-parse-math | plt-annotation-get-path-effects | plt-annotation-get-picker | plt-annotation-get-position | plt-annotation-get-rasterized | plt-annotation-get-rotation | plt-annotation-get-rotation-mode | plt-annotation-get-size | plt-annotation-get-sketch-params | plt-annotation-get-snap | plt-annotation-get-stretch | plt-annotation-get-style | plt-annotation-get-text | plt-annotation-get-tightbbox | plt-annotation-get-transform | plt-annotation-get-transform-rotates-text | plt-annotation-get-transformed-clip-path-and-affine | plt-annotation-get-unitless-position | plt-annotation-get-url | plt-annotation-get-usetex | plt-annotation-get-va | plt-annotation-get-variant | plt-annotation-get-verticalalignment | plt-annotation-get-visible | plt-annotation-get-weight | plt-annotation-get-window-extent | plt-annotation-get-wrap | plt-annotation-get-zorder | plt-annotation-have-units | plt-annotation-is-transform-set | plt-annotation-pchanged | plt-annotation-pick | plt-annotation-pickable | plt-annotation-properties | plt-annotation-remove | plt-annotation-remove-callback | plt-annotation-set | plt-annotation-set-agg-filter | plt-annotation-set-alpha | plt-annotation-set-animated | plt-annotation-set-anncoords | plt-annotation-set-annotation-clip | plt-annotation-set-antialiased | plt-annotation-set-backgroundcolor | plt-annotation-set-bbox | plt-annotation-set-c | plt-annotation-set-clip-box | plt-annotation-set-clip-on | plt-annotation-set-clip-path | plt-annotation-set-color | plt-annotation-set-family | plt-annotation-set-figure | plt-annotation-set-font | plt-annotation-set-font-properties | plt-annotation-set-fontfamily | plt-annotation-set-fontname | plt-annotation-set-fontproperties | plt-annotation-set-fontsize | plt-annotation-set-fontstretch | plt-annotation-set-fontstyle | plt-annotation-set-fontvariant | plt-annotation-set-fontweight | plt-annotation-set-gid | plt-annotation-set-ha | plt-annotation-set-horizontalalignment | plt-annotation-set-in-layout | plt-annotation-set-label | plt-annotation-set-linespacing | plt-annotation-set-ma | plt-annotation-set-math-fontfamily | plt-annotation-set-mouseover | plt-annotation-set-multialignment | plt-annotation-set-name | plt-annotation-set-parse-math | plt-annotation-set-path-effects | plt-annotation-set-picker | plt-annotation-set-position | plt-annotation-set-rasterized | plt-annotation-set-rotation | plt-annotation-set-rotation-mode | plt-annotation-set-size | plt-annotation-set-sketch-params | plt-annotation-set-snap | plt-annotation-set-stretch | plt-annotation-set-style | plt-annotation-set-text | plt-annotation-set-transform | plt-annotation-set-transform-rotates-text | plt-annotation-set-url | plt-annotation-set-usetex | plt-annotation-set-va | plt-annotation-set-variant | plt-annotation-set-verticalalignment | plt-annotation-set-visible | plt-annotation-set-weight | plt-annotation-set-wrap | plt-annotation-set-x | plt-annotation-set-y | plt-annotation-set-zorder | plt-annotation-update | plt-annotation-update-bbox-position-size | plt-annotation-update-from | plt-annotation-update-positions | plt-annotation-attrs ) )?
