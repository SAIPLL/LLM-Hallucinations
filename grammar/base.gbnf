root ::= "```" singleLineComment* importstmt+ statement+ endmarker "```"
importstmt ::= (importname | importfrom) newline
importname ::= "import " dottedasnames

# note below: the ('.' | '...') is necessary because '...' is tokenized as ELLIPSIS
importfrom ::= ( "from " ( ("." | "...")* dottedname | ("." | "...")+ ) " import " ( "*" | "(" importasnames ")" | importasnames ) )
importasname ::= name (" as " name)?
dottedasname ::= dottedname (" as " name)?
importasnames ::= importasname (", " importasname)* (", ")?
dottedasnames ::= dottedasname (", " dottedasname)*
dottedname ::= name ("." name)*

statement ::=
    ( singleLineComment* name space "=" space expression singleLineComment* newline) |
    ( singleLineComment* name "(" arglist? ")" singleLineComment* newline)

expression ::= term ( ( "+" | "-" ) term)*
term ::= factor ( ( "*" | "@" | "/" | "%" | "//" ) factor)*
factor ::= ( "+" | "-" | "~" ) factor | power
power ::= atomexpr ("**" factor)?
atomexpr ::= atom (trailer)*
atom ::=
    ( "(" space (testlistcomp)? space ")" ) |
    ( "[" space (testlistcomp)? space "]" ) |
    ( "{" space (dictorsetmaker)? space  "}" ) |
    value

testlistcomp ::= namedexprtest "," (namedexprtest)* (",")?
# Change name to lib to indicate library logic if matched
trailer ::= library | "." methods | "(" (arglist)? ")" | "[" subscriptlist "]"
subscriptlist ::= subscript ("," subscript)* (",")?
subscript ::= test | (test)? ":" (test)? (sliceop)?
sliceop ::= ":" (test)?
dictorsetmaker ::= 
       ( ((test ":" test | "**" expression) ("," (test ":" test | "**" expression))* (",")?) |
       ( test "," (test)* (",")?) )

namedexprtest ::= test (":= " test)?
test ::= expression (compop expression)*
compop ::= ( "<" | ">" | "==" | ">=" | "<=" | "<>" | "!=" | " in " | " not in " | " is " | " is not " )

classdef ::= "class " name ("(" space? (arglist)? space? ")")? ":" suite

suite ::= newline indent statement

arglist ::= argument ("," argument)*  (",")?
argument ::= atomexpr | atomexpr "=" atomexpr

endmarker ::= ""
indent ::= "\t"
newline ::= "\n"
name ::= [a-zA-Z_] [a-zA-Z_0-9]*
ws ::= ([ \t\n]+)
singleLineComment ::= "#" [^\n]* "\n"
unknown ::= value
kwargs ::= testlistcomp
array ::= "[" space ( value ("," space value)* )? "]" space
bool ::= ("True" | "False") space
char ::= [^"\\] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F])
decimal-part ::= [0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9])?)?)?)?)?)?)?)?)?)?)?)?)?)?)?
integral-part ::= [0-9] | [1-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9] ([0-9])?)?)?)?)?)?)?)?)?)?)?)?)?)?)?
integer ::= ("-"? integral-part) space
null ::= "null" space
none ::= "None" space
number ::= ("-"? integral-part) ("." decimal-part)? ([eE] [-+]? integral-part)? space
object ::= "{" space ( string ":" space value ("," space string ":" space value)* )? "}" space
space ::= " "?
string ::= "\"" char* "\"" space
value ::= object | array | string | number | bool | null | none

# Adds library logic